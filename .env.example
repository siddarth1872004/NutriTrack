# Supabase Postgres connection URI. Use the exact URI from Supabase Database settings.
# For Vercel serverless runtime, prefer the Transaction pooler when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
# Set these only in your local shell for a one-time run of npm run db:seed-accounts.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_DIETITIAN_USERNAME=dietitian
INITIAL_DIETITIAN_PASSWORD=
