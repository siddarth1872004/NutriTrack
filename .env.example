# Supabase PostgreSQL connection URI (Project Settings -> Database -> Connection string).
# Use the Transaction pooler (port 6543) for a hosted server, or the direct connection for migrations.
# Keep this file private. Copy it to .env.local and fill in the values; never commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Only for the one-time `npm run db:seed-accounts` command. Do not keep these in your env files.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
INITIAL_DIETITIAN_USERNAME=dietitian
INITIAL_DIETITIAN_PASSWORD=

